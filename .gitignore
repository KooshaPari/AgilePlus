../*
../.*
*.toml
*.yaml
*.json
!pyproject.toml
!deny.toml
!.gitleaks.toml
!Cargo.toml
!package.json
!vercel.json
!.commitlintrc.json
!.coderabbit.yaml
!desktop/pnpm-lock.yaml
