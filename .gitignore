!ruff.toml

# Environment configuration
.env
.env.local
.env.*.local

# Git worktrees (Claude Code artifact directories)
.worktrees/
.claude/worktrees/
worktrees/

# Vercel
.vercel

# Local DBs
*.db
*.sqlite
*.sqlite3

# Lockfiles inside vendored sub-shells
crates/agileplus-dashboard/desktop-electrobun/bun.lock

# Separate sibling checkouts (worktrees of other repos)
PhenoObservability/
target/

# Rust build artifacts (already had target/ above; .fingerprint/ also noisy)
**/.fingerprint/
**/build-script-build
.agileplus/
# Explicit DB patterns below also untrack already-tracked SQLite files
# (the .agileplus/ line above does not untrack files git already knows about).
# See .githooks/pre-commit-validate-timestamps for the durability guard
# against future non-RFC3339 updated_at rows.
.agileplus/*.db
.agileplus/*.db-*
.agileplus/*.db-wal
.agileplus/*.db-shm
.agileplus/*.db-journal

# python test cache
**/__pycache__/
**/.coverage
*.pyc
*.pyo
**/*.pyc
node_modules/
.tauri/
agileplus-recovery-wtrees/

# Disposable browser verification output
crates/agileplus-dashboard/web/operator-browser-report/
crates/agileplus-dashboard/web/test-results/
crates/agileplus-dashboard/web/operator-browser-receipt.png
