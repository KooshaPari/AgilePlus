#!/bin/bash
# PR Requirements Validator
# Validates that a feature is ready for PR submission
#
# Usage: bin/pvalidate [--feature <slug>] [--check <check>]
#
# Checks:
#   all       - Run all checks (default)
#   spec      - Check kitty-spec exists and WPs are complete
#   docs      - Check documentation page exists
#   changelog - Check CHANGELOG.md entry exists
#   visual    - Check for GIFs/screenshots in docs/assets

set -e

# Find project root (directory containing kitty-specs)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Verify we're in the right place
if [ ! -d "$PROJECT_ROOT/kitty-specs" ]; then
  # Try to find kitty-specs in parent directories
  CURRENT="$SCRIPT_DIR"
  while [ "$CURRENT" != "/" ]; do
    if [ -d "$CURRENT/kitty-specs" ]; then
      PROJECT_ROOT="$CURRENT"
      break
    fi
    CURRENT="$(dirname "$CURRENT")"
  done
fi

cd "$PROJECT_ROOT" || { echo "Error: Could not find project root with kitty-specs"; exit 1; }

FEATURE=""
CHECK="all"
VERBOSE=false

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --feature)
      FEATURE="$2"
      shift 2
      ;;
    --check)
      CHECK="$2"
      shift 2
      ;;
    --verbose)
      VERBOSE=true
      shift
      ;;
    --help)
      echo "Usage: pvalidate [--feature <slug>] [--check <all|spec|docs|changelog|visual>]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

PASS=0
FAIL=0

pass() {
  echo -e "${GREEN}✓${NC} $1"
  ((PASS++))
}

fail() {
  echo -e "${RED}✗${NC} $1"
  ((FAIL++))
}

warn() {
  echo -e "${YELLOW}⚠${NC} $1"
}

# Detect feature from branch if not specified
if [ -z "$FEATURE" ]; then
  BRANCH=$(git rev-parse --abbrev-ref HEAD)
  # Try to extract feature ID from branch name
  if [[ "$BRANCH" =~ ^([0-9]+)- ]]; then
    FEATURE="${BASH_REMATCH[1]}"
    echo "Detected feature ID from branch: $FEATURE"
  elif [[ "$BRANCH" =~ /([0-9]+)- ]]; then
    FEATURE="${BASH_REMATCH[1]}"
    echo "Detected feature ID from branch: $FEATURE"
  else
    echo "Error: Could not detect feature ID from branch '$BRANCH'"
    echo "Usage: pvalidate --feature <slug-or-id>"
    exit 1
  fi
fi

echo ""
echo "🔍 Validating PR requirements for feature: $FEATURE"
echo ""

# Check 1: Spec exists
if [ "$CHECK" = "all" ] || [ "$CHECK" = "spec" ]; then
  echo "📋 Checking specification..."
  
  # Look for spec directory
  SPEC_DIR=""
  if [ -d "kitty-specs/$FEATURE" ]; then
    SPEC_DIR="kitty-specs/$FEATURE"
  else
    # Try to find by pattern
    SPEC_DIR=$(find kitty-specs -maxdepth 1 -name "*${FEATURE}*" -type d | head -1)
  fi
  
  if [ -n "$SPEC_DIR" ] && [ -f "$SPEC_DIR/spec.md" ]; then
    pass "Spec exists at $SPEC_DIR/spec.md"
    
    # Check for complete work packages
    COMPLETE=$(grep -c "\- \[x\]" "$SPEC_DIR/spec.md" 2>/dev/null || echo 0)
    TOTAL=$(grep -c "\- \[\]" "$SPEC_DIR/spec.md" 2>/dev/null || echo 0)
    TOTAL=$((TOTAL + COMPLETE))
    
    # Check status
    if grep -q "Status.*Complete" "$SPEC_DIR/spec.md" || \
       grep -q "Status.*complete" "$SPEC_DIR/spec.md"; then
      pass "Spec status is Complete"
    else
      warn "Spec status may not be marked as Complete"
    fi
  else
    fail "Spec not found at kitty-specs/$FEATURE/spec.md"
  fi
  echo ""
fi

# Check 2: Documentation exists
if [ "$CHECK" = "all" ] || [ "$CHECK" = "docs" ]; then
  echo "📖 Checking documentation..."
  
  # Search for docs mentioning this feature
  DOC_FOUND=false
  for doc in $(find docs -name "*.md" -type f 2>/dev/null | grep -v ".vitepress"); do
    if grep -q "$FEATURE" "$doc" 2>/dev/null; then
      pass "Documentation found: $doc"
      DOC_FOUND=true
      break
    fi
  done
  
  if [ "$DOC_FOUND" = false ]; then
    # Check common paths
    if [ -f "docs/dashboard/$FEATURE.md" ] || [ -f "docs/cli/$FEATURE.md" ] || [ -f "docs/api/$FEATURE.md" ]; then
      pass "Documentation page exists"
    else
      fail "No documentation page found for feature $FEATURE"
    fi
  fi
  
  # Check VitePress sidebar
  if grep -q "$FEATURE" docs/.vitepress/site-meta.mjs 2>/dev/null || \
     grep -q "$FEATURE" docs/.vitepress/config.mts 2>/dev/null; then
    pass "Documentation linked in VitePress sidebar"
  else
    warn "Documentation may not be linked in VitePress sidebar"
  fi
  echo ""
fi

# Check 3: Changelog entry
if [ "$CHECK" = "all" ] || [ "$CHECK" = "changelog" ]; then
  echo "📝 Checking CHANGELOG..."
  
  if grep -q "$FEATURE" CHANGELOG.md 2>/dev/null || \
     grep -q "#$(echo $FEATURE | sed 's/^0*//')" CHANGELOG.md 2>/dev/null; then
    pass "CHANGELOG.md entry found"
    
    # Check for visual reference
    if grep -A2 -B2 "$FEATURE\|#$(echo $FEATURE | sed 's/^0*//')" CHANGELOG.md | grep -q "!\[" 2>/dev/null; then
      pass "CHANGELOG entry includes visual reference (GIF/image)"
    else
      warn "CHANGELOG entry may be missing visual reference"
    fi
  else
    fail "No CHANGELOG.md entry found for feature $FEATURE"
  fi
  echo ""
fi

# Check 4: Visual assets
if [ "$CHECK" = "all" ] || [ "$CHECK" = "visual" ]; then
  echo "🎬 Checking visual assets..."
  
  # Check for GIFs
  GIF_COUNT=$(find docs/assets -name "*.gif" -type f 2>/dev/null | wc -l)
  PNG_COUNT=$(find docs/assets -name "*.png" -type f 2>/dev/null | wc -l)
  
  if [ "$GIF_COUNT" -gt 0 ]; then
    pass "Found $GIF_COUNT GIF(s) in docs/assets"
  else
    warn "No GIFs found in docs/assets/gifs/"
  fi
  
  if [ "$PNG_COUNT" -gt 0 ]; then
    pass "Found $PNG_COUNT screenshot(s) in docs/assets"
  else
    warn "No screenshots found in docs/assets/screenshots/"
  fi
  
  # Check if feature-specific assets exist
  if find docs/assets -name "*$FEATURE*" -type f 2>/dev/null | grep -q .; then
    pass "Feature-specific assets found"
  else
    warn "No assets with feature ID '$FEATURE' in filename"
  fi
  echo ""
fi

# Summary
echo "─────────────────────────────"
echo "Summary: $PASS passed, $FAIL failed"

if [ $FAIL -gt 0 ]; then
  echo ""
  echo "❌ PR NOT READY"
  echo "   Fix the failed checks above before creating your PR."
  echo "   See: GOVERNANCE_PR_REQUIREMENTS.md"
  exit 1
else
  echo ""
  echo "✅ PR REQUIREMENTS MET"
  echo "   You can create your PR now!"
  echo "   Remember to embed your GIF/screenshot in the PR description."
  exit 0
fi
