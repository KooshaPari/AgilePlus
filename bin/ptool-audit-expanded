#!/usr/bin/env python3
"""
Phenotype Tooling Audit - EXPANDED DATABASE (50+ tools)

Detects forbidden/legacy tools across categories:
- Package managers, Task runners, Test frameworks, Bundlers
- Container/Orchestration, Database tools, CI/CD
- Documentation, Security, Monitoring
"""

import argparse
import json
import os
import re
import sys
from dataclasses import dataclass, asdict
from pathlib import Path
from typing import Dict, List, Optional, Set


@dataclass
class ToolRule:
    name: str
    category: str
    status: str  # 'allowed', 'forbidden', 'deprecated', 'discouraged', 'legacy'
    preferred_alternative: Optional[str] = None
    reason: Optional[str] = None
    file_patterns: List[str] = None
    content_patterns: List[str] = None
    severity: str = "error"
    autofix_available: bool = False
    migration_guide: Optional[str] = None
    
    def __post_init__(self):
        if self.file_patterns is None:
            self.file_patterns = []
        if self.content_patterns is None:
            self.content_patterns = []


# ============ EXPANDED TOOLING DATABASE (50+ TOOLS) ============

EXPANDED_TOOLING_DATABASE: Dict[str, ToolRule] = {
