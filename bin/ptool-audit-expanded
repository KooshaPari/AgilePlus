        name="adr-missing",
        category="documentation",
        status="discouraged",
        preferred_alternative="docs/adr/ or ADR.md",
        reason="Architecture Decision Records should be documented",
        file_patterns=["ADR.md", "docs/adr/"],
        content_patterns=[],
        severity="warning",
    ),
    "wiki": ToolRule(
        name="wiki",
        category="documentation",
        status="discouraged",
        preferred_alternative="docs/ directory in repo",
        reason="GitHub wikis are separate repos and get out of sync; keep docs in main repo",
        file_patterns=["wiki/"],
        content_patterns=[r'github.com/.*/wiki'],
        severity="warning",
    ),
    "notion-docs": ToolRule(
        name="notion-docs",
        category="documentation",
        status="discouraged",
        preferred_alternative="docs/ directory in repo",
        reason="Notion docs are external and not version controlled; use in-repo docs",
        file_patterns=[],
        content_patterns=[r'notion.so', r'notion.site'],
        severity="warning",
    ),
    
    # ===== SECURITY (4 tools) =====
    "snyk": ToolRule(
        name="snyk",
        category="security",
        status="discouraged",
        preferred_alternative="osv-scanner or trivy",
        reason="Snyk requires signup; OSV is open and free",
        file_patterns=[".snyk"],
        content_patterns=[r'snyk', r'snyk test', r'snyk monitor'],
        severity="warning",
    ),
    "osv-scanner": ToolRule(
        name="osv-scanner",
        category="security",
        status="allowed",
        reason="Open source vulnerability scanner",
        file_patterns=["osv-scanner.toml"],
        content_patterns=[r'osv-scanner', r'osv'],
        severity="info",
    ),
    "trivy": ToolRule(
        name="trivy",
        category="security",
        status="allowed",
        reason="Container and dependency vulnerability scanner",
        file_patterns=[".trivyignore"],
        content_patterns=[r'trivy', r'trivy image', r'trivy fs'],
        severity="info",
    ),
    "gitleaks": ToolRule(
        name="gitleaks",
        category="security",
        status="allowed",
        reason="Secret detection in git history",
        file_patterns=[".gitleaks.toml", ".gitleaksignore"],
        content_patterns=[r'gitleaks', r'gitleaks detect'],
        severity="info",
    ),
}


# ... rest of implementation same as original ...

class ToolingAuditor:
    """Audits a codebase for forbidden/discouraged tooling."""
    
    def __init__(self, database: Dict[str, ToolRule] = None):
        self.database = database or EXPANDED_TOOLING_DATABASE
        self.violations = []
        self.allowed_tools_found = set()
        
    def audit_directory(self, path: Path, respect_gitignore: bool = True):
        """Audit a directory for tooling violations."""
        self.violations = []
        self.allowed_tools_found = set()
        
        ignore_patterns = self._load_gitignore_patterns(path) if respect_gitignore else set()
        
        # Special check: README.md missing
        readme_path = path / "README.md"
        if not readme_path.exists():
            rule = self.database.get("readme-missing")
            if rule:
                self._add_violation(rule, path / "README.md (missing)", None, is_missing=True)
        else:
            self.allowed_tools_found.add("readme-present")
        
        for root, dirs, files in os.walk(path):
            dirs[:] = [d for d in dirs if not self._should_ignore(d, ignore_patterns)]
            
            for file in files:
                if self._should_ignore(file, ignore_patterns):
                    continue
                file_path = Path(root) / file
                self._audit_file(file_path)
        
        return self.violations
    
    def _load_gitignore_patterns(self, path: Path) -> set:
        patterns = {"node_modules", ".git", "target", "dist", "build", ".venv", "__pycache__", ".pytest_cache"}
        gitignore_path = path / ".gitignore"
        if gitignore_path.exists():
            try:
                content = gitignore_path.read_text()
                for line in content.splitlines():
                    line = line.strip()
                    if line and not line.startswith("#"):
                        patterns.add(line.rstrip("/"))
            except:
                pass
        return patterns
    
    def _should_ignore(self, name: str, patterns: set) -> bool:
        for pattern in patterns:
            if pattern in name or name in pattern:
                return True
        return False
    
    def _audit_file(self, file_path: Path):
        file_name = file_path.name
        
        for tool_name, rule in self.database.items():
            # Skip special rules handled separately
            if tool_name == "readme-missing":
                continue
                
            for pattern in rule.file_patterns:
                if self._match_pattern(file_name, pattern):
                    if rule.status in ("forbidden", "deprecated"):
                        self._add_violation(rule, file_path, None)
                    elif rule.status == "allowed":
                        self.allowed_tools_found.add(tool_name)
        
        if self._should_check_contents(file_path):
            try:
                content = file_path.read_text(encoding="utf-8", errors="ignore")
                lines = content.splitlines()
                
                for tool_name, rule in self.database.items():
                    for pattern in rule.content_patterns:
                        for i, line in enumerate(lines, 1):
                            if re.search(pattern, line):
                                if rule.status in ("forbidden", "deprecated", "discouraged"):
                                    self._add_violation(rule, file_path, i, line.strip())
                                elif rule.status == "allowed":
                                    self.allowed_tools_found.add(tool_name)
            except:
                pass
    
    def _match_pattern(self, file_name: str, pattern: str) -> bool:
        if "*" in pattern:
            import fnmatch
            return fnmatch.fnmatch(file_name, pattern)
        return file_name == pattern
    
    def _should_check_contents(self, file_path: Path) -> bool:
        ext = file_path.suffix.lower()
        return ext in (".js", ".ts", ".json", ".yml", ".yaml", ".toml", ".py", ".sh", ".md")
    
    def _add_violation(self, rule: ToolRule, file_path: Path, line: int = None, context: str = "", is_missing: bool = False):
        message = f"{rule.status.upper()}: {rule.name} ({rule.category})"
        if rule.reason:
            message += f" - {rule.reason}"
        
        fix_suggestion = None
        if rule.preferred_alternative:
            fix_suggestion = f"Use {rule.preferred_alternative} instead"
            if rule.migration_guide:
                fix_suggestion += f" (see: {rule.migration_guide})"
        
        violation = {
            "tool": rule.name,
            "category": rule.category,
            "file": str(file_path),
            "line": line,
            "severity": rule.severity,
            "message": message,
            "fix_suggestion": fix_suggestion,
            "autofix_available": rule.autofix_available,
        }
        
        # Avoid duplicates
        if not any(v.get("file") == violation["file"] and v.get("tool") == violation["tool"] 
                   for v in self.violations):
            self.violations.append(violation)
    
    def generate_report(self, format: str = "markdown") -> str:
        if format == "json":
            return json.dumps(self.violations, indent=2, default=str)
        
        if format == "markdown":
            lines = [
                "# Tooling Audit Report (Expanded Database)",
                "",
                f"**Total Violations:** {len(self.violations)}",
                f"**Allowed Tools Found:** {', '.join(sorted(self.allowed_tools_found)) or 'None'}",
                "",
            ]
            
            # Group by category
            by_category = {}
            for v in self.violations:
                cat = v.get("category", "unknown")
                by_category.setdefault(cat, []).append(v)
            
            for category, violations in sorted(by_category.items()):
                lines.extend([f"## {category.replace('_', ' ').title()}", ""])
                
                errors = [v for v in violations if v.get("severity") == "error"]
                warnings = [v for v in violations if v.get("severity") == "warning"]
                
                if errors:
                    lines.extend(["### Errors (Must Fix)", ""])
                    for v in errors:
                        location = v.get("file", "unknown")
                        if v.get("line"):
                            location += f":{v['line']}"
                        lines.append(f"- **{v.get('tool', 'unknown')}** in `{location}`")
                        lines.append(f"  - {v.get('message', '')}")
                        if v.get("fix_suggestion"):
                            autofix = "[autofix] " if v.get("autofix_available") else ""
                            lines.append(f"  - {autofix}Fix: {v['fix_suggestion']}")
                        lines.append("")
                
                if warnings:
                    lines.extend(["### Warnings (Should Fix)", ""])
                    for v in warnings:
                        location = v.get("file", "unknown")
                        if v.get("line"):
                            location += f":{v['line']}"
                        lines.append(f"- **{v.get('tool', 'unknown')}** in `{location}`")
                        lines.append(f"  - {v.get('message', '')}")
                        if v.get("fix_suggestion"):
                            autofix = "[autofix] " if v.get("autofix_available") else ""
                            lines.append(f"  - {autofix}Fix: {v['fix_suggestion']}")
                        lines.append("")
            
            return "\n".join(lines)
        
        lines = [f"Tooling Audit: {len(self.violations)} violations"]
        for v in self.violations:
            location = v.get("file", "unknown")
            if v.get("line"):
                location += f":{v['line']}"
            lines.append(f"[{v.get('severity', 'info').upper()}] {v.get('tool', 'unknown')} at {location}")
            lines.append(f"  {v.get('message', '')}")
            if v.get("fix_suggestion"):
                lines.append(f"  -> {v['fix_suggestion']}")
        return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(description="Phenotype Tooling Audit (Expanded)")
    parser.add_argument("--path", "-p", type=Path, default=Path("."), help="Path to audit")
    parser.add_argument("--format", "-f", choices=["text", "markdown", "json"], default="markdown")
    parser.add_argument("--output", "-o", type=Path, help="Output file")
    parser.add_argument("--strict", "-s", action="store_true", help="Exit with error on violations")
    parser.add_argument("--category", "-c", help="Filter by category")
    parser.add_argument("--export-database", action="store_true", help="Export the tooling database")
    parser.add_argument("--list-forbidden", action="store_true", help="List all forbidden tools")
    
    args = parser.parse_args()
    
    if args.export_database:
        db = {k: asdict(v) for k, v in EXPANDED_TOOLING_DATABASE.items()}
        print(json.dumps(db, indent=2))
        return
    
    if args.list_forbidden:
        forbidden = {k: v for k, v in EXPANDED_TOOLING_DATABASE.items() if v.status == "forbidden"}
        print("# Forbidden Tools (Must Not Use)")
        print("")
        for name, rule in sorted(forbidden.items()):
            print(f"- **{name}** ({rule.category})")
            print(f"  Use instead: {rule.preferred_alternative}")
            print(f"  Reason: {rule.reason}")
            print("")
        return
    
    auditor = ToolingAuditor()
    violations = auditor.audit_directory(args.path)
    
    if args.category:
        violations = [v for v in violations if v.get("category") == args.category]
    
    report = auditor.generate_report(args.format)
    
    if args.output:
        args.output.write_text(report)
        print(f"Report written to {args.output}")
    else:
        print(report)
    
    if args.strict and violations:
        errors = [v for v in violations if v.get("severity") == "error"]
        if errors:
            sys.exit(1)
    
    sys.exit(0)


if __name__ == "__main__":
    main()
