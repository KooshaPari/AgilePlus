        preferred_alternative="task",
        reason="Task is the standardized task runner (Makefile handrolls are error-prone)",
        file_patterns=["Makefile", "makefile", "GNUmakefile"],
        content_patterns=[r'make ', r'make\t', r'\.PHONY'],
        severity="error",
    ),
    "just": ToolRule(
        name="just",
        category="task_runner",
        status="discouraged",
        preferred_alternative="task",
        reason="Task is the standardized task runner across all repos",
        file_patterns=["justfile", "Justfile", ".justfile"],
        content_patterns=[r'just ', r'@just'],
        severity="warning",
    ),
    "task": ToolRule(
        name="task",
        category="task_runner",
        status="allowed",
        file_patterns=["Taskfile.yml", "Taskfile.yaml", "taskfile.yml"],
        content_patterns=[r'task ', r'task:'],
        severity="info",
    ),
    
    # Test Frameworks
    "jest": ToolRule(
        name="jest",
        category="test_framework",
        status="forbidden",
        preferred_alternative="vitest",
        reason="Vitest is the standardized test runner (faster, native ESM, Vite-aligned)",
        file_patterns=["jest.config.js", "jest.config.ts", "jest.setup.js"],
        content_patterns=[r'jest\(', r'from.*jest', r'@jest/globals'],
        severity="error",
    ),
    "mocha": ToolRule(
        name="mocha",
        category="test_framework",
        status="forbidden",
        preferred_alternative="vitest",
        reason="Mocha is legacy; Vitest provides better ESM and TypeScript support",
        file_patterns=[".mocharc.js", ".mocharc.json", ".mocharc.yml"],
