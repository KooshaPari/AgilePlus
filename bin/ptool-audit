#!/usr/bin/env python3
"""
Phenotype Tooling Audit (ptool-audit)

Detects forbidden/legacy tools and enforces standardized tooling across repos.
Blocks usage of deprecated tools where modern alternatives are mandated.
"""

import argparse
import json
import os
import re
import sys
from dataclasses import dataclass, asdict
from pathlib import Path
from typing import Dict, List, Optional, Set


@dataclass
class ToolRule:
    """Rule for a specific tool/package manager/test framework."""
    name: str
    category: str  # 'package_manager', 'task_runner', 'test_framework', 'build_tool', 'bundler'
    status: str  # 'allowed', 'forbidden', 'deprecated', 'discouraged'
    preferred_alternative: Optional[str] = None
    reason: Optional[str] = None
    file_patterns: List[str] = None
    content_patterns: List[str] = None
    severity: str = "error"  # 'error', 'warning', 'info'
    autofix_available: bool = False
    
    def __post_init__(self):
        if self.file_patterns is None:
            self.file_patterns = []
        if self.content_patterns is None:
            self.content_patterns = []


# Canonical tooling database - the "source of truth" for allowed/forbidden tools
TOOLING_DATABASE: Dict[str, ToolRule] = {
    # Package Managers
    "npm": ToolRule(
        name="npm",
        category="package_manager",
        status="forbidden",
        preferred_alternative="bun",
        reason="Bun is the standardized package manager for JS/TS projects",
        file_patterns=["package-lock.json", "npm-shrinkwrap.json", ".npmrc"],
        content_patterns=[r'"npm":', r'npm install', r'npm run'],
        severity="error",
    ),
    "yarn": ToolRule(
        name="yarn",
        category="package_manager",
        status="forbidden",
        preferred_alternative="bun",
        reason="Bun is the standardized package manager for JS/TS projects",
        file_patterns=["yarn.lock", ".yarnrc", ".yarnrc.yml"],
        content_patterns=[r'yarn install', r'yarn run', r'yarn add'],
        severity="error",
    ),
    "pnpm": ToolRule(
        name="pnpm",
