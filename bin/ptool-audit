        content_patterns=[r'pip install', r'pip3 install'],
        severity="warning",
    ),
    "uv": ToolRule(
        name="uv",
        category="package_manager",
        status="allowed",
        file_patterns=["uv.lock", "pyproject.toml"],
        content_patterns=[r'uv add', r'uv run', r'uv pip'],
        severity="info",
    ),
    
    # Task Runners
    "make": ToolRule(
        name="make",
        category="task_runner",
