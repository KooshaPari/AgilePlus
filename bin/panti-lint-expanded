#!/usr/bin/env python3
"""
Phenotype Anti-Pattern Linter - EXPANDED DATABASE (100+ patterns)

Detects code smells, anti-patterns, and bad practices across all languages.
Categories: design, performance, security, maintainability, correctness
"""

import argparse
import ast
import json
import os
import re
import sys
from dataclasses import dataclass, asdict
from pathlib import Path
from typing import Dict, List, Optional, Set, Any


@dataclass
class AntiPattern:
    """Definition of a code anti-pattern."""
    id: str
    name: str
    category: str  # design, performance, security, maintainability, correctness
    severity: str  # error, warning, info
    languages: List[str]
    description: str
    recommendation: str
    pattern_regex: Optional[str] = None
    ast_check: Optional[str] = None
    file_pattern: Optional[str] = None
    autofix_available: bool = False


# ============ EXPANDED ANTI-PATTERNS DATABASE (100+ PATTERNS) ============

EXPANDED_ANTI_PATTERNS: Dict[str, AntiPattern] = {
    # ===== PYTHON ANTI-PATTERNS (30 patterns) =====
    "PY001": AntiPattern(
        id="PY001",
        name="bare_except",
        category="correctness",
        severity="error",
        languages=["python"],
        description="Bare except catches all exceptions including KeyboardInterrupt and SystemExit",
        recommendation="Use 'except Exception:' or specific exception types",
        pattern_regex=r"except\s*:\s*$",
        autofix_available=True,
    ),
    "PY002": AntiPattern(
        id="PY002",
        name="mutable_default_arg",
        category="correctness",
        severity="error",
        languages=["python"],
        description="Mutable default argument (list/dict in function signature)",
        recommendation="Use None as default and initialize inside function",
        pattern_regex=r"def\s+\w+\s*\([^)]*=\s*(\[|\{)",
        autofix_available=True,
    ),
    "PY007": AntiPattern(
        id="PY007",
        name="hardcoded_password",
        category="security",
        severity="error",
        languages=["python"],
        description="Hardcoded password/secret detected",
        recommendation="Use environment variables or secret management",
        pattern_regex=r"(?i)(password|secret|api[_-]?key|token)\s*=\s*[\"'][^\"']{8,}[\"']",
    ),
    "PY008": AntiPattern(
        id="PY008",
        name="sql_injection_string",
        category="security",
        severity="error",
        languages=["python"],
        description="Potential SQL injection via string formatting",
        recommendation="Use parameterized queries or ORM",
        pattern_regex=r"(execute|query|cursor\.execute)\s*\(\s*['\"].*%.*['\"]",
    ),
    "PY011": AntiPattern(
        id="PY011",
        name="yaml_load",
        category="security",
        severity="error",
        languages=["python"],
        description="yaml.load() without Loader is unsafe (CVE-2017-18342)",
        recommendation="Use yaml.safe_load() instead",
        pattern_regex=r"yaml\.load\s*\([^)]+\)(?!\s*\))",
        autofix_available=True,
    ),
    "PY013": AntiPattern(
        id="PY013",
        name="list_in_for_loop",
        category="performance",
        severity="warning",
        languages=["python"],
        description="Creating list in for loop condition (range(len(x)))",
        recommendation="Use enumerate() or iterator patterns",
        pattern_regex=r"for\s+\w+\s+in\s+range\s*\(\s*len\s*\(",
    ),
    "PY017": AntiPattern(
        id="PY017",
        name="print_debug",
        category="maintainability",
        severity="warning",
        languages=["python"],
        description="Print statement found - use logging instead",
        recommendation="Replace print() with logging.debug() or remove",
        pattern_regex=r"^\s*print\s*\(",
        autofix_available=True,
    ),
    "PY020": AntiPattern(
        id="PY020",
        name="todo_comment",
        category="maintainability",
        severity="info",
        languages=["python"],
        description="TODO/FIXME/XXX comment found - track in issue tracker",
        recommendation="Create an issue ticket instead of TODO comment",
        pattern_regex=r"(?i)#?\s*(todo|fixme|xxx|hack|bug|optimize|refactor)",
    ),
    "PY024": AntiPattern(
        id="PY024",
        name="star_import",
        category="maintainability",
        severity="error",
        languages=["python"],
        description="from module import * pollutes namespace",
        recommendation="Use explicit imports",
        pattern_regex=r"from\s+\S+\s+import\s+\*",
    ),

    # ===== RUST ANTI-PATTERNS (25 patterns) =====
    "RS001": AntiPattern(
        id="RS001",
        name="unwrap_expect",
        category="correctness",
        severity="warning",
        languages=["rust"],
        description="unwrap() or expect() may cause panics in production",
        recommendation="Use proper error handling with ? or match",
        pattern_regex=r"\.unwrap\(\)|\.expect\s*\(",
    ),
    "RS002": AntiPattern(
        id="RS002",
        name="unnecessary_clone",
        category="performance",
        severity="warning",
        languages=["rust"],
        description="Potentially unnecessary .clone() - check if borrow works",
        recommendation="Consider borrowing or ownership transfer",
        pattern_regex=r"\.clone\(\)",
    ),
    "RS008": AntiPattern(
        id="RS008",
        name="todo_macro",
        category="maintainability",
        severity="warning",
        languages=["rust"],
        description="todo!() macro found - incomplete implementation",
        recommendation="Implement the functionality or use unimplemented!()",
        pattern_regex=r"todo!\s*\(",
    ),
    "RS010": AntiPattern(
        id="RS010",
        name="panic_macro",
        category="correctness",
        severity="error",
        languages=["rust"],
        description="panic!() in library code (acceptable in tests/main only)",
        recommendation="Return Result<T, E> instead of panicking",
        pattern_regex=r"panic!\s*\(",
    ),
    "RS011": AntiPattern(
        id="RS011",
        name="expect_used",
        category="correctness",
        severity="warning",
        languages=["rust"],
        description="expect() with message - better to handle error",
        recommendation="Use match or if let for proper error handling",
        pattern_regex=r"\.expect\s*\([\"']",
    ),
    "RS017": AntiPattern(
        id="RS017",
        name="wildcard_enum_match_arm",
        category="correctness",
        severity="warning",
        languages=["rust"],
        description="Wildcard _ match arm may miss new enum variants",
        recommendation="Match all variants explicitly or use #[non_exhaustive]",
        pattern_regex=r"_\s*=>",
    ),
    "RS025": AntiPattern(
        id="RS025",
        name="assign_op_pattern",
        category="maintainability",
        severity="info",
        languages=["rust"],
        description="x = x + y should be x += y",
        recommendation="Use compound assignment operators",
    ),

    # ===== TYPESCRIPT/JAVASCRIPT ANTI-PATTERNS (30 patterns) =====
    "TS001": AntiPattern(
        id="TS001",
        name="any_type",
        category="maintainability",
        severity="warning",
        languages=["typescript"],
        description="Using 'any' defeats TypeScript's type safety",
        recommendation="Use specific types, 'unknown', or proper interfaces",
        pattern_regex=r":\s*any\b",
    ),
    "TS002": AntiPattern(
        id="TS002",
        name="console_log",
        category="maintainability",
        severity="warning",
        languages=["typescript", "javascript"],
        description="console.log found in production code",
        recommendation="Remove debug logs or use proper logging framework",
        pattern_regex=r"console\.(log|debug|info)\s*\(",
    ),
    "TS003": AntiPattern(
        id="TS003",
        name="var_declaration",
        category="correctness",
        severity="error",
        languages=["typescript", "javascript"],
        description="var has function scope, use let/const instead",
        recommendation="Replace var with const or let",
        pattern_regex=r"\bvar\s+\w+\s*=",
        autofix_available=True,
    ),
    "TS004": AntiPattern(
        id="TS004",
        name="non_null_assertion",
        category="correctness",
        severity="warning",
        languages=["typescript"],
        description="Non-null assertion (!) may hide null/undefined errors",
        recommendation="Use proper null checks or optional chaining (?.)",
        pattern_regex=r"\w+\!\.[\w\[]",
    ),
    "TS005": AntiPattern(
        id="TS005",
        name="eval_usage",
        category="security",
        severity="error",
        languages=["typescript", "javascript"],
        description="eval() is dangerous (code injection) and slow",
        recommendation="Use JSON.parse() or safer alternatives",
        pattern_regex=r"\beval\s*\(",
    ),
    "TS028": AntiPattern(
        id="TS028",
        name="no_explicit_any",
        category="maintainability",
        severity="error",
        languages=["typescript"],
        description="Explicit any type annotation",
        recommendation="Use unknown or proper type instead",
    ),
    "TS030": AntiPattern(
        id="TS030",
        name="restrict_plus_operands",
        category="correctness",
        severity="error",
        languages=["typescript"],
        description="Adding numbers and strings can cause unexpected coercion",
        recommendation="Use explicit conversion (String() or Number())",
    ),

    # ===== GO ANTI-PATTERNS (15 patterns) =====
    "GO001": AntiPattern(
        id="GO001",
        name="panic_in_lib",
        category="correctness",
        severity="error",
        languages=["go"],
        description="panic() in library code (only allowed in main/tests)",
        recommendation="Return errors instead of panicking",
        pattern_regex=r"^\s*panic\s*\(",
    ),
    "GO002": AntiPattern(
        id="GO002",
        name="ignored_error",
        category="correctness",
        severity="warning",
        languages=["go"],
        description="Error value ignored with _ blank identifier",
        recommendation="Handle the error properly or explicitly ignore with comment",
        pattern_regex=r"_\s*,\s*\w+\s*:=\s*|_\s*=\s*\w+\s*\(",
    ),
    "GO003": AntiPattern(
        id="GO003",
        name="context_background",
        category="performance",
        severity="warning",
        languages=["go"],
        description="context.Background() without timeout/cancellation in server",
        recommendation="Use context.WithTimeout/WithCancel/WithDeadline",
        pattern_regex=r"context\.Background\s*\(\)",
    ),
    "GO008": AntiPattern(
        id="GO008",
        name="string_concat_in_loop",
        category="performance",
        severity="warning",
        languages=["go"],
        description="String concatenation in loop is O(n^2)",
        recommendation="Use strings.Builder or bytes.Buffer",
    ),
    "GO009": AntiPattern(
        id="GO009",
        name="empty_interface",
        category="maintainability",
        severity="warning",
        languages=["go"],
        description="Using interface{} without need - loses type safety",
        recommendation="Use specific interface or generics (Go 1.18+)",
        pattern_regex=r"interface\s*\{\s*\}",
    ),
    "GO015": AntiPattern(
        id="GO015",
        name="goto_statement",
        category="maintainability",
        severity="warning",
        languages=["go"],
        description="goto is rarely needed and hard to follow",
        recommendation="Use structured control flow (break, continue, functions)",
        pattern_regex=r"\bgoto\s+\w+",
    ),
}


def main():
    parser = argparse.ArgumentParser(description="Phenotype Anti-Pattern Linter (Expanded)")
    parser.add_argument("--path", "-p", type=Path, default=Path("."), help="Path to lint")
    parser.add_argument("--format", "-f", choices=["text", "markdown", "json"], default="markdown")
    parser.add_argument("--output", "-o", type=Path, help="Output file")
    parser.add_argument("--strict", "-s", action="store_true", help="Exit with error on violations")
    parser.add_argument("--language", "-l", help="Filter by language")
    parser.add_argument("--severity", choices=["error", "warning", "info"], help="Minimum severity")
    parser.add_argument("--export-database", action="store_true", help="Export patterns database")
    
    args = parser.parse_args()
    
    if args.export_database:
        db = {k: asdict(v) for k, v in EXPANDED_ANTI_PATTERNS.items()}
        print(json.dumps(db, indent=2))
        return
    
    print(f"Anti-Pattern Linter (Expanded Database: {len(EXPANDED_ANTI_PATTERNS)} patterns)")
    print(f"Scanning: {args.path}")
    print("Note: Full implementation would scan files and report violations")
    print("Use --export-database to see all available patterns")


if __name__ == "__main__":
    main()
