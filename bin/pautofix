def detect_project_type(project_path: Path) -> Dict[str, List[str]]:
    """Detect what types of migrations are applicable."""
    detected = {
        "package_manager": [],
        "task_runner": [],
        "test_framework": [],
        "bundler": [],
        "linter": [],
        "python_linter": [],
        "ci": [],
    }
    
    # Check for package managers
    if (project_path / "package-lock.json").exists():
        detected["package_manager"].append("npm")
    if (project_path / "yarn.lock").exists():
        detected["package_manager"].append("yarn")
    if (project_path / "pnpm-lock.yaml").exists():
        detected["package_manager"].append("pnpm")
    
    # Check for task runners
    if (project_path / "Makefile").exists() or (project_path / "makefile").exists():
        detected["task_runner"].append("make")
    if (project_path / "justfile").exists():
        detected["task_runner"].append("just")
    
    # Check for test frameworks
    if (project_path / "jest.config.js").exists() or (project_path / "jest.config.ts").exists():
        detected["test_framework"].append("jest")
    if (project_path / ".mocharc.js").exists():
        detected["test_framework"].append("mocha")
    
    # Check for bundlers
    if (project_path / "webpack.config.js").exists() or (project_path / "webpack.config.ts").exists():
        detected["bundler"].append("webpack")
    
    # Check for linters
    if (project_path / ".eslintrc.js").exists() or (project_path / ".eslintrc.json").exists():
        detected["linter"].append("eslint")
    if (project_path / ".prettierrc").exists():
        detected["linter"].append("prettier")
    
    # Check for Python linters
    if (project_path / ".flake8").exists():
        detected["python_linter"].append("flake8")
    
    # Check for CI
    if (project_path / ".circleci").exists():
        detected["ci"].append("circleci")
    if (project_path / ".travis.yml").exists():
        detected["ci"].append("travis")
    
    return detected


def generate_migration_plan(project_path: Path, migration_type: str) -> List[dict]:
    """Generate a migration plan for a specific type."""
    plan = []
    migration = MIGRATIONS.get(migration_type)
    if not migration:
        return plan
    
    # Files to remove
    for pattern in migration.get("files_to_remove", []):
        for file_path in project_path.rglob(pattern):
            if file_path.is_file():
                plan.append({
                    "action": "remove",
                    "file": str(file_path.relative_to(project_path)),
                    "reason": f"Replace with {migration['to_tool']}",
                })
    
    # Files to create
    for filename, content in migration.get("files_to_create", {}).items():
        target = project_path / filename
        if not target.exists():
            plan.append({
                "action": "create",
                "file": filename,
                "reason": f"New configuration for {migration['to_tool']}",
            })
    
    return plan


def execute_migration(project_path: Path, migration_type: str, dry_run: bool = True) -> bool:
    """Execute a migration plan."""
    migration = MIGRATIONS.get(migration_type)
    if not migration:
        print(f"Unknown migration type: {migration_type}")
        return False
    
    plan = generate_migration_plan(project_path, migration_type)
    
    if not plan:
        print(f"No actions needed for {migration_type}")
        return True
    
    print(f"\n{'='*60}")
    print(f"Migration: {migration['description']}")
    print(f"{'='*60}")
    
    for action in plan:
        file_path = project_path / action["file"]
        
        if action["action"] == "remove":
            if dry_run:
                print(f"[DRY-RUN] Would remove: {action['file']}")
            else:
                if file_path.exists():
                    file_path.unlink()
                    print(f"Removed: {action['file']}")
        
        elif action["action"] == "create":
            if dry_run:
                print(f"[DRY-RUN] Would create: {action['file']}")
            else:
                file_path.parent.mkdir(parents=True, exist_ok=True)
                file_path.write_text(MIGRATIONS[migration_type]["files_to_create"].get(action["file"], ""))
                print(f"Created: {action['file']}")
    
    return True


def list_available_migrations():
    """Print all available migrations."""
    print("Available migrations:\n")
    for key, mig in sorted(MIGRATIONS.items()):
        print(f"  {key}")
        print(f"    Description: {mig['description']}")
        print(f"    From: {', '.join(mig['from_patterns'])}")
        print(f"    To: {mig['to_tool']}")
        print()


def main():
    # Handle --list-migrations before argparse
    if "--list-migrations" in sys.argv or "-l" in sys.argv:
        list_available_migrations()
        return
    
    parser = argparse.ArgumentParser(description="Phenotype Auto-Migration Tool")
    parser.add_argument("--path", "-p", type=Path, default=Path("."), help="Project path")
    parser.add_argument("--type", "-t", choices=list(MIGRATIONS.keys()) + ["all"], default="all",
                       help="Migration type")
    parser.add_argument("--dry-run", "-d", action="store_true",
                       help="Preview changes without applying")
    parser.add_argument("--apply", "-a", action="store_true",
                       help="Apply migrations (requires --type)")
    parser.add_argument("--list-migrations", "-l", action="store_true",
                       help="List available migrations")
    
    args = parser.parse_args()
    
    if args.list_migrations:
        list_available_migrations()
        return
    
    project_path = args.path.resolve()
    
    if not project_path.exists():
        print(f"Error: Path does not exist: {project_path}")
        sys.exit(1)
    
    print(f"Scanning {project_path} for migration opportunities...")
    
    detected = detect_project_type(project_path)
    applicable = {k: v for k, v in detected.items() if v}
    
    if not applicable:
        print("No legacy tools detected. Nothing to migrate!")
        sys.exit(0)
    
    print(f"\nDetected legacy tooling:")
    for mig_type, tools in applicable.items():
        print(f"  - {mig_type}: {', '.join(tools)}")
    
    if args.type == "all":
        mig_types = list(applicable.keys())
    else:
        mig_types = [args.type]
    
    success = True
    for mig_type in mig_types:
        if mig_type not in applicable:
            print(f"\nSkipping {mig_type} (not detected)")
            continue
        
        if not execute_migration(project_path, mig_type, dry_run=args.dry_run):
            success = False
    
    print(f"\n{'='*60}")
    if args.dry_run:
        print("This was a DRY RUN. No changes were made.")
        print("Use --apply to execute the migration.")
    else:
        print("Migration complete!")
    print(f"{'='*60}")
    
    sys.exit(0 if success else 1)


if __name__ == "__main__":
    main()
