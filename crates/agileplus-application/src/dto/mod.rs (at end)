    // ── ExportRequest ────────────────────────────────────────────────────────

    #[test]
    fn export_request_serde_roundtrip() {
        let req = ExportRequest {
            format: ExportFormat::Markdown,
            output_path: Some("/out.md".into()),
            with_side: true,
        };
        let json = serde_json::to_string(&req).unwrap();
        let back: ExportRequest = serde_json::from_str(&json).unwrap();
        assert_eq!(back.format, ExportFormat::Markdown);
        assert!(back.with_side);
    }

    #[test]
    fn export_request_default_side_false() {
        let json = r#"{"format":"csv"}"#;
        let req: ExportRequest = serde_json::from_str(json).unwrap();
        assert!(!req.with_side);
        assert!(req.output_path.is_none());
    }

    // ── ExportFormat variants ────────────────────────────────────────────────

    #[test]
    fn export_format_all_variants_serde() {
        let formats = [
            (ExportFormat::Markdown, r#""markdown""#),
            (ExportFormat::Csv, r#""csv""#),
            (ExportFormat::Html, r#""html""#),
            (ExportFormat::Mermaid, r#""mermaid""#),
            (ExportFormat::Dot, r#""dot""#),
        ];
        for (expected, json_str) in &formats {
            let fmt: ExportFormat = serde_json::from_str(json_str).unwrap();
            assert_eq!(&fmt, expected);
        }
    }

    #[test]
    fn export_format_debug_and_copy() {
        let fmt = ExportFormat::Html;
        let copied = fmt;
        assert_eq!(fmt, copied);
        let dbg = format!("{:?}", fmt);
        assert_eq!(dbg, "Html");
    }

