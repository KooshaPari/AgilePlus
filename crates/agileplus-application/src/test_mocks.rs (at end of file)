    // ── SpyPublisher ─────────────────────────────────────────────────────────

    #[test]
    fn spy_publisher_starts_empty() {
        let spy = SpyPublisher::default();
        assert!(spy.emitted().is_empty());
    }

    #[test]
    fn spy_publisher_records_events() {
        let spy = SpyPublisher::default();
        spy.publish(DomainEvent::FeatureCreated {
            id: 1,
            slug: "a".into(),
        })
        .unwrap();
        spy.publish(DomainEvent::StoryCreated {
            id: 2,
            epic_id: 1,
            title: "T".into(),
        })
        .unwrap();

        let events = spy.emitted();
        assert_eq!(events.len(), 2);
        assert!(matches!(&events[0], DomainEvent::FeatureCreated { slug, .. } if slug == "a"));
        assert!(matches!(&events[1], DomainEvent::StoryCreated { id: 2, .. }));
    }

    #[test]
    fn spy_publisher_emitted_returns_clone() {
        let spy = SpyPublisher::default();
        spy.publish(DomainEvent::FeatureCreated {
            id: 1,
            slug: "x".into(),
        })
        .unwrap();

        let first = spy.emitted();
        let second = spy.emitted();
        assert_eq!(first, second);
    }
