    // ── InMemoryFeatureRepo ──────────────────────────────────────────────────

    #[tokio::test]
    async fn feature_repo_create_and_get() {
        let repo = InMemoryFeatureRepo::default();
        let feature = Feature::new("auth", "Auth", [0u8; 32], None);
        let id = repo.create_feature(&feature).await.unwrap();
        assert_eq!(id, 1);

        let got = repo.get_feature_by_id(id).await.unwrap().unwrap();
        assert_eq!(got.slug, "auth");
        assert_eq!(got.id, 1);
    }

    #[tokio::test]
    async fn feature_repo_get_nonexistent_returns_none() {
        let repo = InMemoryFeatureRepo::default();
        let got = repo.get_feature_by_id(999).await.unwrap();
        assert!(got.is_none());
    }

    #[tokio::test]
    async fn feature_repo_auto_increment_ids() {
        let repo = InMemoryFeatureRepo::default();
        let f1 = Feature::new("a", "A", [0u8; 32], None);
        let f2 = Feature::new("b", "B", [0u8; 32], None);
        let id1 = repo.create_feature(&f1).await.unwrap();
        let id2 = repo.create_feature(&f2).await.unwrap();
        assert_eq!(id1, 1);
        assert_eq!(id2, 2);
    }

    #[tokio::test]
    async fn feature_repo_update_state() {
        let repo = InMemoryFeatureRepo::default();
        let feature = Feature::new("f", "F", [0u8; 32], None);
        let id = repo.create_feature(&feature).await.unwrap();

        repo.update_feature_state(id, FeatureState::Specified)
            .await
            .unwrap();

        let got = repo.get_feature_by_id(id).await.unwrap().unwrap();
        assert_eq!(got.state, FeatureState::Specified);
    }

    #[tokio::test]
    async fn feature_repo_update_state_not_found() {
        let repo = InMemoryFeatureRepo::default();
        let err = repo.update_feature_state(999, FeatureState::Specified).await;
        assert!(err.is_err());
    }

    #[tokio::test]
    async fn feature_repo_update_feature() {
        let repo = InMemoryFeatureRepo::default();
        let mut feature = Feature::new("f", "F", [0u8; 32], None);
        let id = repo.create_feature(&feature).await.unwrap();

        feature.id = id;
        feature.slug = "updated".into();
        repo.update_feature(&feature).await.unwrap();

        let got = repo.get_feature_by_id(id).await.unwrap().unwrap();
        assert_eq!(got.slug, "updated");
    }

    #[tokio::test]
    async fn feature_repo_update_feature_not_found() {
        let repo = InMemoryFeatureRepo::default();
        let feature = Feature::new("f", "F", [0u8; 32], None);
        let err = repo.update_feature(&feature).await;
        assert!(err.is_err());
    }

    #[tokio::test]
    async fn feature_repo_get_by_slug() {
        let repo = InMemoryFeatureRepo::default();
        let feature = Feature::new("my-slug", "F", [0u8; 32], None);
        repo.create_feature(&feature).await.unwrap();

        let got = repo.get_feature_by_slug("my-slug").await.unwrap();
        assert!(got.is_some());
        assert_eq!(got.unwrap().slug, "my-slug");
    }

    #[tokio::test]
    async fn feature_repo_get_by_slug_missing() {
        let repo = InMemoryFeatureRepo::default();
        let got = repo.get_feature_by_slug("nope").await.unwrap();
        assert!(got.is_none());
    }

    #[tokio::test]
    async fn feature_repo_list_by_state() {
        let repo = InMemoryFeatureRepo::default();
        let f1 = Feature::new("a", "A", [0u8; 32], None);
        let f2 = Feature::new("b", "B", [0u8; 32], None);
        let id1 = repo.create_feature(&f1).await.unwrap();
        let id2 = repo.create_feature(&f2).await.unwrap();
        repo.update_feature_state(id2, FeatureState::Specified)
            .await
            .unwrap();

        let created = repo.list_features_by_state(FeatureState::Created).await.unwrap();
        assert_eq!(created.len(), 1);
        assert_eq!(created[0].slug, "a");

        let specified = repo.list_features_by_state(FeatureState::Specified).await.unwrap();
        assert_eq!(specified.len(), 1);
        assert_eq!(specified[0].slug, "b");
    }

    #[tokio::test]
    async fn feature_repo_list_all() {
        let repo = InMemoryFeatureRepo::default();
        repo.create_feature(&Feature::new("a", "A", [0u8; 32], None))
            .await
            .unwrap();
        repo.create_feature(&Feature::new("b", "B", [0u8; 32], None))
            .await
            .unwrap();

        let all = repo.list_all_features().await.unwrap();
        assert_eq!(all.len(), 2);
    }

    #[tokio::test]
    async fn feature_repo_list_by_label() {
        let repo = InMemoryFeatureRepo::default();
        let mut f1 = Feature::new("a", "A", [0u8; 32], None);
        f1.labels.push("backend".into());
        let mut f2 = Feature::new("b", "B", [0u8; 32], None);
        f2.labels.push("frontend".into());
        repo.create_feature(&f1).await.unwrap();
        repo.create_feature(&f2).await.unwrap();

        let backend = repo.list_features_by_label("backend").await.unwrap();
        assert_eq!(backend.len(), 1);
        assert_eq!(backend[0].slug, "a");

        let all = repo.list_features_by_label("nonexistent").await.unwrap();
        assert!(all.is_empty());
    }

