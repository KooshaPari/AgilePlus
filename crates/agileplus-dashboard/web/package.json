{
  "name": "agileplus-dashboard-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:tsc": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit -p tsconfig.json",
    "typecheck:experimental": "bun run typecheck:tsgo",
