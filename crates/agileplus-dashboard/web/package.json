    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.11"
