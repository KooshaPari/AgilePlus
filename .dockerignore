.git
.gitignore
*.md
!docs/
!docs/requirements/
!docs/requirements/*.md
.env*
!.env.example
# Build artifacts
target/
dist/
build/
*.o
*.a
*.so
# IDE
.vscode/
.idea/
*.swp
.DS_Store
# Test/nested
**/node_modules
**/target
**/.pytest_cache
**/__pycache__
**/*.test
**/tests/
# The Docker Rust build compiles the full workspace, which includes these
# test-only members and their explicit test targets.
!tests/
!tests/e2e/**
!tests/bdd/**
# Logs
*.log
**/*.log
# Coverage reports
coverage/
.coverage
*.coverage
# Python virtual environments
venv/
env/
virtualenv/
# npm/yarn
package-lock.json
yarn.lock
pnpm-lock.yaml
# Rust
**/.cargo
**/Cargo.lock
!Cargo.lock
# Go
go.sum
vendor/
# Go build cache
go-build/
# Java
*.class
target/
build/
**/.gradle
**/build/
**/target/
**/.maven/
# Node.js
.next/
.nuxt/
/.output/
.dist/
# TypeScript
**/tsconfig.tsbuildinfo
# Docker compose
docker-compose.override.yml
# Local dev files
local.env
.env.local
# Temp files
*.tmp
*.temp
**/temp/
**/tmp/
