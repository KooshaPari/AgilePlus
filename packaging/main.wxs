<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- AgilePlus CLI Installer -->
  <?define ProductVersion="!(bind.FileVersion.agileplus.exe)" ?>
  <?define CompanyName="Phenotype Labs" ?>
  <?define ProductName="AgilePlus CLI" ?>
  <?define ProductCodeGuid="*" ?>
  <?define UpgradeCodeGuid="12345678-1234-1234-1234-123456789999" ?>
  <?define InstallScope="perMachine" ?>

  <Product
    Id="$(var.ProductCodeGuid)"
    Name="$(var.ProductName)"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="$(var.CompanyName)"
    UpgradeCode="$(var.UpgradeCodeGuid)">

    <Package
      InstallerVersion="200"
      Compressed="yes"
      InstallScope="$(var.InstallScope)"
      Description="$(var.ProductName) - Spec-first project management CLI with FR/NFR traceability" />

    <Media Id="1" Cabinet="agileplus.cab" EmbedCab="yes" />

    <!-- Remove previous versions on upgrade -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />

    <Feature Id="ProductFeature" Title="$(var.ProductName)" Level="1">
      <ComponentRef Id="BinariesComponent" />
      <ComponentRef Id="DocsComponent" />
      <ComponentRef Id="PathComponent" />
    </Feature>

    <!-- UI for installation progress -->
    <UI>
      <UIRef Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog"
        Control="Finish"
        Event="DoAction"
        Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>

    <!-- Installation directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="$(var.InstallScope = 'perMachine' ? 'ProgramFilesFolder' : 'LocalAppDataFolder')">
        <Directory Id="INSTALLFOLDER" Name="AgilePlus" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="AgilePlus" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Binaries -->
    <Feature Id="Binaries" Title="AgilePlus CLI" Level="1">
      <Component Id="BinariesComponent" Directory="INSTALLFOLDER" Guid="*">
        <File
          Id="Agileplus.exe"
          Name="agileplus.exe"
          DiskId="1"
          Source="!(bindfilepath.agileplus.exe)"
          Vital="yes" />
        <Environment
          Id="PATH"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
      </Component>
    </Feature>

    <!-- Documentation -->
    <Feature Id="Docs" Title="Documentation" Level="1">
      <Component Id="DocsComponent" Directory="INSTALLFOLDER" Guid="*">
        <!-- License file -->
        <File
          Id="License.txt"
          Name="LICENSE.txt"
          DiskId="1"
          Source="LICENSE"
          Vital="no" />
      </Component>
    </Feature>

    <!-- Dummy path component -->
    <Feature Id="PathFeature" Title="Add to PATH" Level="1">
      <Component Id="PathComponent" Directory="INSTALLFOLDER" Guid="*">
        <CreateFolder />
      </Component>
    </Feature>

    <!-- Start Menu Shortcuts -->
    <Feature Id="StartMenuShortcuts" Title="Start Menu Shortcuts" Level="1">
      <Component Id="StartMenuComponent" Directory="ApplicationProgramsFolder" Guid="*">
        <Shortcut
          Id="Agileplus.CommandPrompt"
          Name="AgilePlus CLI"
          Description="AgilePlus — Spec-first project management CLI"
          Target="[SystemFolder]cmd.exe"
          Arguments="/K &quot;[INSTALLFOLDER]agileplus.exe&quot; --help"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\Phenotype Labs\AgilePlus"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </Feature>

  </Product>

</Wix>
