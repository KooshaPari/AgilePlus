#!/bin/bash
# Pre-commit hook: Validates conventional commits, scans for secrets, and reminds about PR requirements
# Install: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "🔍 Running pre-commit checks..."

# 1. Conventional Commit Check
if [ -z "$1" ]; then
  COMMIT_MSG=$(cat)
else
  COMMIT_MSG=$(cat "$1")
fi

CONVENTIONAL_PATTERN="^(feat|fix|docs|style|refactor|perf|test|chore|ci|revert|build)(
?.+\)?!?: .{1,100}"

if ! echo "$COMMIT_MSG" | grep -qE "$CONVENTIONAL_PATTERN"; then
  echo "❌ Commit message does not follow conventional commits"
  echo ""
  echo "Expected format: type(scope)?: subject"
  echo "Types: feat, fix, docs, style, refactor, perf, test, chore, ci, revert, build"
  echo "Example: feat(dashboard): add service control panel"
  exit 1
fi

echo "✅ Conventional commit format OK"

# 2. Gitleaks Secret Scan
echo "🔍 Running gitleaks scan..."

if command -v gitleaks &>/dev/null; then
  RESULT=$(gitleaks detect --redact --no-color -s . 2>&1) || SCAN_RESULT=$?
  
  if [ "${SCAN_RESULT:-0}" -eq 1 ]; then
    echo "❌ SECRET DETECTED! Commit blocked."
    echo "$RESULT"
    echo ""
    echo "To bypass for legitimate false positive, use:"
    echo "  git commit --no-verify -m 'message'"
    exit 1
  fi
  
  echo "✅ No secrets detected"
else
  echo "⚠️  gitleaks not installed. Install: brew install gitleaks"
fi

# 3. PR Requirements Reminder (for feature branches)
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$BRANCH" =~ ^(feat|feature)/ ]] || [[ "$BRANCH" =~ ^[0-9]+- ]] || [[ "$BRANCH" =~ ^eco-[0-9]+ ]]; then
  echo ""
  echo "📋 PR Requirements Reminder (branch: $BRANCH)"
  echo "   Before creating your PR, ensure:"
  echo "   ✓ Visual evidence (screenshot/GIF) in PR description"
  echo "   ✓ kitty-spec at kitty-specs/<feature-id>/ is complete"
  echo "   ✓ Documentation page at docs/<category>/<feature>.md"
  echo "   ✓ CHANGELOG.md entry with visual preview"
  echo ""
  echo "   Validate with: ./bin/pvalidate --feature <id>"
  echo "   See: GOVERNANCE_PR_REQUIREMENTS.md"
fi

exit 0
