#!/bin/bash
# Pre-commit hook to scan for secrets before commit
# Install: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Uses trufflehog (not gitleaks): gitleaks spawns 20+ hung concurrent processes
# in multi-agent sessions. trufflehog is single-shot and reliable.
# Matches hook pattern in civ and parpour.

set -e

echo "Running trufflehog secret scan..."

if command -v trufflehog >/dev/null 2>&1; then
    trufflehog git file://. --since-commit HEAD --only-verified --fail || exit 1
    echo "No verified secrets detected"
else
    echo "trufflehog not installed; skipping. Install: brew install trufflesecurity/trufflehog/trufflehog"
fi
