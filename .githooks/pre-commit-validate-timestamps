#!/usr/bin/env bash
# .githooks/pre-commit-validate-timestamps
#
# Reject commits that introduce non-RFC3339 timestamps in any staged
# .agileplus/*.db file.
#
# This is the durable guard against the B.x finding (5 corrupt updated_at rows
# in commit ea5a517a 2026-08-07 10:43:57 UTC that gecko fixed on
# 2026-10-18T09:46:39Z). All 14 repository UPDATE bindings audited use
# chrono::Utc::now().to_rfc3339(); the binary file replacement in ea5a517a is
# the only known root cause, so this hook blocks any future direct commit
# of a non-RFC3339 updated_at value in a staged SQLite file.
#
# Bypass:   HOOKS_SKIP=1 git commit
#           PRE_COMMIT_SKIP_TIMESTAMPS=1 git commit
#           git commit --no-verify
#
# This hook is invoked from .githooks/pre-commit when
# core.hooksPath=.githooks is configured. It can also be invoked directly
# against any SQLite file: HOOK_TARGET=/path/to.db ./pre-commit-validate-timestamps
set -euo pipefail

if [ "${HOOKS_SKIP:-0}" = "1" ]; then
  echo "[hooks] HOOKS_SKIP=1; skipping pre-commit-validate-timestamps"
  exit 0
fi

if [ "${PRE_COMMIT_SKIP_TIMESTAMPS:-0}" = "1" ]; then
  echo "[hooks] PRE_COMMIT_SKIP_TIMESTAMPS=1; skipping timestamp scan"
  exit 0
fi

if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "[hooks] pre-commit-validate-timestamps: sqlite3 not found in PATH; skipping check" >&2
  exit 0
fi

# grep is load-bearing: it both sanitises table names and (in the staged-path
# scan) filters .db paths. If grep is unavailable its exit status is
# indistinguishable from a failed match, which previously caused every table
# to be reported as an "unsafe table name" and silently skipped — i.e. a
# missing grep turned the whole validation into a no-op pass. Fail closed.
if ! command -v grep >/dev/null 2>&1; then
  echo "[hooks] pre-commit-validate-timestamps: FAIL — grep not found in PATH; required for table-name sanitisation. Failing closed." >&2
  exit 1
fi

# Resolve the directory holding this hook (and the python validator).
hook_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Allow a manual scan against an explicit file via HOOK_TARGET=<path>
if [ -n "${HOOK_TARGET:-}" ]; then
  staged_dbs="$HOOK_TARGET"
else
  # Find any staged .agileplus/*.db files (added or modified).
  staged_dbs="$(git diff --cached --name-only --diff-filter=AM 2>/dev/null | grep -E '^\.agileplus/.*\.db$' || true)"
fi

if [ -z "$staged_dbs" ]; then
  exit 0
fi

bad_files=0
for db in $staged_dbs; do
  if [ ! -f "$db" ]; then
    # HOOK_TARGET might point to a file outside the repo; tolerate it.
    if [ -n "${HOOK_TARGET:-}" ]; then
      echo "[hooks] pre-commit-validate-timestamps: HOOK_TARGET=$db not found" >&2
      exit 1
    fi
    continue
  fi

  echo "[hooks] pre-commit-validate-timestamps: scanning $db for non-RFC3339 updated_at rows..."

  # Find every table whose CREATE TABLE sql mentions an updated_at column.
  # We avoid sqlite_master queries that touch every row by using the schema.
  tables="$(sqlite3 "$db" "SELECT name FROM sqlite_master WHERE type='table' AND sql LIKE '%updated_at%' AND name NOT LIKE 'sqlite_%'" 2>/dev/null || true)"

  file_bad=0
  for table in $tables; do
    # Sanitize table name (single quote escape) — sqlite3 identifiers cannot be
    # bound via parameters, but we verify the table exists via the previous query.
    # Refuse anything that doesn't match a safe identifier.
    if ! printf '%s' "$table" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*$'; then
      echo "[hooks] pre-commit-validate-timestamps: FAIL — unsafe table name (not a plain identifier): $table" >&2
      file_bad=$((file_bad + 1))
      continue
    fi

    # Updated_at must be a genuine UTC RFC3339 timestamp. SQLite GLOB is
    # neither precise enough (it accepts invalid calendar/time and
    # trailing garbage) nor does it enforce UTC. The strong check is
    # delegated to the Python validator at $HOOK_DIR/rfc3339-utc-
    # validate.py, which validates:
    #   - YYYY-MM-DD with month 01-12 and day 01-31 (Feb 30 rejected;
    #     leap-year rules: divisible by 4 except centuries unless 400)
    #   - HH:MM:SS with hour 00-23, minute 00-59, second 00-59
    #   - Optional fractional seconds (1+ digits)
    #   - Timezone: literal 'Z' (Zulu) OR '+00:00' (chrono's default)
    #   - No trailing whitespace or other characters
    # The validator matches chrono's actual emission
    # (DateTime<Utc>.to_rfc3339() = `YYYY-MM-DDTHH:MM:SS.fffffffff+00:00`
    # by default; `YYYY-MM-DDTHH:MM:SSZ` with use_z=True).
    #
    # SQLite's role is reduced to: extract candidate rows (id +
    # updated_at) without filtering. The Python validator does the
    # actual accept/reject decision. Existence of any rejected row
    # aborts the commit. Limit to 20 rows for output manageability.
    if ! command -v python3 >/dev/null 2>&1; then
      echo "[hooks] pre-commit-validate-timestamps: python3 not found in PATH; required by strict UTC RFC3339 validator. Install python3 or set PRE_COMMIT_SKIP_TIMESTAMPS=1 (not recommended)." >&2
      exit 1
    fi
    validator="$hook_dir/rfc3339-utc-validate.py"
    if [ ! -f "$validator" ]; then
      echo "[hooks] pre-commit-validate-timestamps: FAIL — validator missing: $validator" >&2
      exit 1
    fi
    rows="$(sqlite3 "$db" "SELECT id, updated_at FROM ${table} WHERE updated_at IS NOT NULL LIMIT 20" 2>/dev/null || true)"
    if [ -z "$rows" ]; then
      continue
    fi
    # Run the validator, keeping its stderr for diagnostics, and capture its exit
    # code WITHOUT `|| true` swallowing it. Exit codes:
    #   0 = every row is genuine UTC RFC3339
    #   1 = at least one row rejected (printed on stdout)
    #   2 = usage/IO error (message on stderr, nothing on stdout)
    #   >=126 = could not execute (missing interpreter, crash)
    # Anything other than 0 is a hard failure. Previously `|| true` forced
    # bad_rc to 0 and `2>/dev/null` hid stderr, so a crashed or absent
    # validator silently passed the commit. Now: 1 -> report rejected rows,
    # anything else -> propagate as an infrastructure failure. Either way the
    # commit is rejected; no failure mode degrades into a pass.
    set +e
    bad_rows="$(printf '%s\n' "$rows" | python3 "$validator" 2>&1 >/dev/null)"
    validator_rc=$?
    rejected_rows="$(printf '%s\n' "$rows" | python3 "$validator" 2>/dev/null)"
    rejected_rc=$?
    set -e
    if [ "$rejected_rc" -eq 1 ]; then
      echo "[hooks] pre-commit-validate-timestamps: FAIL — $db table=$table has non-UTC-RFC3339 updated_at rows:" >&2
      echo "$rejected_rows" >&2
      file_bad=$((file_bad + 1))
    elif [ "$rejected_rc" -ne 0 ]; then
      echo "[hooks] pre-commit-validate-timestamps: FAIL — validator error (exit $rejected_rc) on $db table=$table; failing closed." >&2
      if [ -n "$bad_rows" ]; then
        echo "$bad_rows" >&2
      else
        echo "(validator produced no diagnostic output)" >&2
      fi
      file_bad=$((file_bad + 1))
    fi
    if [ "$validator_rc" -ne 0 ] && [ "$validator_rc" -ne "$rejected_rc" ]; then
      echo "[hooks] pre-commit-validate-timestamps: note — validator exit codes disagreed between runs ($validator_rc vs $rejected_rc); failing closed." >&2
      file_bad=$((file_bad + 1))
    fi
  done

  if [ "$file_bad" -gt 0 ]; then
    bad_files=$((bad_files + 1))
  fi
done

if [ "$bad_files" -gt 0 ]; then
  echo "[hooks] pre-commit-validate-timestamps: rejected $bad_files file(s) with non-RFC3339 updated_at rows." >&2
  echo "[hooks] Fix by running the strict Python validator manually:" >&2
  echo "[hooks]   python3 $hook_dir/rfc3339-utc-validate.py < <(sqlite3 <db> 'SELECT id, updated_at FROM <table>')" >&2
  echo "[hooks] Or set PRE_COMMIT_SKIP_TIMESTAMPS=1 (not recommended)." >&2
  exit 1
fi

echo "[hooks] pre-commit-validate-timestamps: all staged .agileplus/*.db files have valid RFC3339 timestamps."
exit 0