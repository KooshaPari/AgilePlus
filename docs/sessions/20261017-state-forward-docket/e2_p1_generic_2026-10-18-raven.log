    V: VcsPort + Send + Sync + 'static,
    O: ObservabilityPort + Send + Sync + 'static,
{
    let initial_state = body
        .state
        .as_deref()
        .map(parse_feature_state)
        .transpose()?
        .unwrap_or(FeatureState::Created);
    if matches!(
        initial_state,
        FeatureState::Validated | FeatureState::Shipped
    ) {
        return Err(ApiError::BadRequest(
            "terminal feature states cannot be assigned at creation; use canonical acceptance/promotion"
                .to_string(),
        ));
    }

    let slug = body.title.to_lowercase().replace(' ', "-");
    let now = Utc::now();
    let feature = Feature {
        id: 0,
        slug: slug.clone(),
        friendly_name: body.title.clone(),
        state: initial_state,
        spec_hash: [0u8; 32],
        target_branch: body.target_branch.unwrap_or_else(|| "main".to_string()),
        plane_issue_id: None,
        plane_state_id: None,
        labels: vec![],
        module_id: None,
        project_id: None,
        created_at: now,
        updated_at: now,
        created_at_commit: None,
        last_modified_commit: None,
    };


