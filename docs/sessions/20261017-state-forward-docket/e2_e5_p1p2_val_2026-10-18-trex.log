  "crates/agileplus-benchmarks",
  "crates/agileplus-api-types",
  "crates/agileplus-cache",
  "crates/agileplus-contract-tests",
  "crates/agileplus-error-core",
  "crates/agileplus-import",
  "crates/agileplus-integration-tests",
  "crates/agileplus-nats",
  "crates/agileplus-config",
  "crates/agileplus-p2p",
  "crates/agileplus-sync",
  "agileplus-agents/crates/agileplus-agent-dispatch",
  "agileplus-agents/crates/agileplus-agent-review",
  "agileplus-agents/crates/agileplus-agent-service",
  "desktop/src-tauri", # Tauri desktop app
  # NOTE: clap-ext temporarily excluded — incompatible clap version constraint (4.3.x vs 4.6.x). Tracked in PR #924.
