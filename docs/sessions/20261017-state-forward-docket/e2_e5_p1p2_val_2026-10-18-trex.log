# Active members — only crates/libs with actual source files.
# Remaining scaffolding (44 crates, 19 libs) tracked but excluded from
# workspace until source is implemented. See: kitty-specs/003-agileplus-platform-completion.
members = [
  "tests/e2e", # installed-CLI round-trip; workflow runs this crate from its manifest directory
  "tests/e2e-desktop", # E2E tests for the Tauri desktop app (DB, CLI bridge, tray, config)
  "tests/transport", # Transport-layer integration tests (gRPC, CLI, IPC)
  "tests/bdd", # fixture and Cucumber acceptance tests
  "crates/agileplus-proto", # canonical tonic/prost gRPC contract
  "crates/agileplus-grpc", # loopback Rust core consumed by the MCP bridge
  "crates/agileplus-cli", # agileplus: spec-first CLI binary
  "crates/agileplus-subcmds", # platform/dashboard CLI subcommands (platform health)
  "crates/agileplus-api", # HTTP API binary (default port 3000)
  "crates/agileplus-application",
  "crates/agileplus-domain",
  "crates/agileplus-governance", # SpecKitty scorecard enforcement (rubric + scoring)
  "crates/traceability-core", # unified PM/traceability spine (un-park 2026-07-04)
  "crates/agileplus-git",
  "crates/agileplus-github",
  "crates/agileplus-graph",
  "crates/agileplus-plane",
  "crates/agileplus-sqlite",
  "crates/agileplus-triage",
  "crates/agileplus-telemetry",
  "crates/agileplus-dashboard",
