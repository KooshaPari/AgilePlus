# AgilePlus runtime environment (additive snippet)
# Merge into your local .env — does not replace .env.example (Sentry block).
#
# See: docs/remediation/OPS.md

# ── CLI / local SQLite ──────────────────────────────────────────────────────
AGILEPLUS_DB=./agileplus.db
# AGILEPLUS_HOME=/path/to/AgilePlus

# ── HTTP API (clients, MCP, integration tests) ─────────────────────────────
AGILEPLUS_API_URL=http://localhost:8080
AGILEPLUS_API_KEY=dev-api-key

# ── gRPC core ───────────────────────────────────────────────────────────────
AGILEPLUS_GRPC_ADDRESS=localhost:50051
# AGILEPLUS_GRPC_URL=agileplus-core:50051

# ── Core service (container / process-compose) ───────────────────────────────
# AGILEPLUS_CORE_DATABASE_PATH=/data/agileplus.db
# AGILEPLUS_CORE_REPO_PATH=/repo
# AGILEPLUS_API_PORT=8080
# AGILEPLUS_API_GRPC_PORT=50051
# AGILEPLUS_TELEMETRY_ENABLED=true
# AGILEPLUS_LOG_LEVEL=info

# ── MCP ─────────────────────────────────────────────────────────────────────
# AGILEPLUS_MCP_PORT=8081

# ── Build metadata (optional — set in CI for version subcommand) ─────────────
# AGILEPLUS_BUILD_SHA=

# ── Rust tracing (overrides config file level) ───────────────────────────────
# RUST_LOG=info,agileplus_cli=debug
# RUST_BACKTRACE=1
